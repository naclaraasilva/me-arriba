<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".ui.ConfiguracoesActivity">

    <include layout="@layout/view_barra_titulo" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_screen"
            android:paddingEnd="@dimen/space_screen"
            android:paddingBottom="28dp">

            <!-- Perfil -->
            <TextView
                style="@style/Text.MeArriba.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/secao_perfil" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MeArriba.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:hint="@string/nome_usuario">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Contatos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.MeArriba.SectionLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/secao_contatos" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddContato"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/adicionar_contato"
                    android:textColor="@color/safe"
                    app:icon="@drawable/ic_add"
                    app:iconTint="@color/safe" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtContatosVazio"
                style="@style/Text.MeArriba.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/contatos_vazio" />

            <LinearLayout
                android:id="@+id/containerContatos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Monitoramento -->
            <TextView
                style="@style/Text.MeArriba.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/secao_monitoramento" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MeArriba.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchMonitoramento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/habilitar_monitoramento"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/txtStatusSensores"
                        style="@style/Text.MeArriba.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/txtStatusPermissao"
                        style="@style/Text.MeArriba.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Modo de transporte -->
            <TextView
                style="@style/Text.MeArriba.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/secao_transporte" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MeArriba.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioGroup
                    android:id="@+id/radioTransporte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <RadioButton
                        android:id="@+id/radioMoto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp"
                        android:text="@string/transporte_moto"
                        android:textColor="@color/text_primary" />

                    <RadioButton
                        android:id="@+id/radioBicicleta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp"
                        android:text="@string/transporte_bike"
                        android:textColor="@color/text_primary" />

                    <RadioButton
                        android:id="@+id/radioCaminhada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp"
                        android:text="@string/transporte_caminhada"
                        android:textColor="@color/text_primary" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <!-- Check-in -->
            <TextView
                style="@style/Text.MeArriba.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/secao_checkin" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MeArriba.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchCheckin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/habilitar_checkin"
                        android:textColor="@color/text_primary" />

                    <LinearLayout
                        android:id="@+id/linhaIntervalo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <TextView
                            style="@style/Text.MeArriba.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/intervalo_checkin" />

                        <TextView
                            android:id="@+id/txtIntervalo"
                            style="@style/Text.MeArriba.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/safe" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="6dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Demonstracao -->
            <TextView
                style="@style/Text.MeArriba.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/secao_demo" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MeArriba.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDemonstracao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/habilitar_demo"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputEndpointLayout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/endpoint_api">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputEndpoint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Permissoes -->
            <TextView
                style="@style/Text.MeArriba.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/secao_permissoes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPermissoes"
                style="@style/Widget.MeArriba.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/permissoes_abrir" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
