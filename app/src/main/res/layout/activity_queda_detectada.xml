<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_screen"
    android:paddingEnd="@dimen/space_screen"
    tools:context=".ui.QuedaDetectadaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_icon_circle_emergency"
            android:gravity="center">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_alert"
                app:tint="@color/white" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/queda_titulo"
            android:textColor="@color/emergency"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPergunta"
            style="@style/Text.MeArriba.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/queda_pergunta"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="212dp"
        android:layout_height="212dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp">

        <com.reserva.sensor_queda.componente.VisaoAnelProgresso
            android:id="@+id/anelContador"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtContador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30"
                android:textColor="@color/emergency"
                android:textSize="64sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/txtContadorHint"
                style="@style/Text.MeArriba.Secondary"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/queda_contador_hint"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/txtTeste"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_pill"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:text="@string/queda_teste"
        android:textColor="@color/secondary_action"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEstouBem"
        style="@style/Widget.MeArriba.Button.Safe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/queda_estou_bem" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrecisoAjuda"
        style="@style/Widget.MeArriba.Button.Danger"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/queda_preciso_ajuda" />

</LinearLayout>
