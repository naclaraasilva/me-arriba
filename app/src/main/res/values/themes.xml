<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Sensorqueda" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/safe</item>
        <item name="colorOnPrimary">@color/background</item>
        <item name="colorSecondary">@color/secondary_action</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorError">@color/emergency</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.Sensorqueda" parent="Base.Theme.Sensorqueda" />

    <!-- Cartoes -->
    <style name="Widget.MeArriba.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Botoes -->
    <style name="Widget.MeArriba.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.MeArriba.Button.Danger" parent="Widget.MeArriba.Button">
        <item name="backgroundTint">@color/emergency</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.MeArriba.Button.Safe" parent="Widget.MeArriba.Button">
        <item name="backgroundTint">@color/safe</item>
        <item name="android:textColor">@color/background</item>
    </style>

    <style name="Widget.MeArriba.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Tipografia -->
    <style name="Text.MeArriba.ScreenTitle" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.MeArriba.SectionLabel" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.MeArriba.CardTitle" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.MeArriba.Body" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Text.MeArriba.Secondary" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
